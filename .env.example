APP_ENV=development

# Either DATABASE_URL or the individual DB_* values can configure MySQL.
DATABASE_URL=
DB_HOST=mysql.example.com
DB_PORT=3306
DB_NAME=check_annotator
DB_USER=check_annotator
DB_PASSWORD=replace-with-database-password

# Replace with a long, randomly generated value outside version control.
AUTH_SECRET_KEY=replace-with-random-secret
CORS_ORIGINS=http://localhost:3000
