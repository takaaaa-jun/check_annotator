APP_ENV=development

# MySQL server connection settings.
# Copy this file to .env, then replace each value for the target server.
# DATABASE_URL may be used instead; leave it empty to use the DB_* fields below.
DATABASE_URL=
DB_HOST=replace-with-database-server-ip-or-hostname
DB_PORT=3306
DB_NAME=replace-with-database-name
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-database-password
DB_SSL_CA=

# Replace with a long, randomly generated value outside version control.
AUTH_SECRET_KEY=replace-with-random-secret
CORS_ORIGINS=http://localhost:3000
