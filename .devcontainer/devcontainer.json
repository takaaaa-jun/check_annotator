{
  "name": "check_annotator",
  "dockerComposeFile": [
    "../docker-compose.yaml",
    "../docker-compose.dev.yaml"
  ],
  "service": "workspace",
  "runServices": [
    "workspace",
    "backend",
    "frontend"
  ],
  "workspaceFolder": "/workspace/check_annotator",
  "shutdownAction": "stopCompose",
  "overrideCommand": false,
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "forwardPorts": [
    3000,
    8000
  ]
}   